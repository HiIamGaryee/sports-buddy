rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------- SHARED

    /**
     * Field limits, mirroring the domain constants in src/constants and
     * src/services/profile/profile-schema.ts. The client enforces these so a
     * person gets a readable error; the rules enforce them again because an
     * attacker can skip the client entirely and call the SDK directly.
     */
    function maxDisplayName() { return 40; }
    function maxBio() { return 160; }
    function maxSports() { return 5; }

    /** A string field that is present, a string, and within `limit`. */
    function boundedString(value, limit) {
      return value is string && value.size() <= limit;
    }

    /** Same, but the field is allowed to be absent or null. */
    function boundedOptionalString(data, key, limit) {
      return !(key in data) || data[key] == null
        || boundedString(data[key], limit);
    }

    function validGender(data) {
      return !('gender' in data) || data.gender == null
        || data.gender in ['male', 'female'];
    }

    function validSocialUsername(data, key) {
      return !(key in data) || data[key] == null || data[key] == ''
        || (data[key] is string
          && data[key].size() <= 64
          && data[key].matches('^[A-Za-z0-9._-]+$'));
    }

    /**
     * True when `uid` is one of the participant segments encoded in a
     * deterministic pair-based document id — `a__b` for a connection, or
     * `a__b__active` for its plan and confirmed activity. Used to admit a
     * `get` on a document that does not exist yet (a transaction checking
     * before it writes), and as the query-independent `list` rule for
     * messages. Once a document exists, `get`/writes still re-derive
     * participation from its stored `participants`.
     */
    function uidInPairId(uid, id) {
      return uid in id.split('__');
    }

    /**
     * No block exists between the two users, in either direction. A block
     * document's id is `blockerId__blockedUserId`, so both orders are
     * checked. Used by connection writes, `connectedParticipant()`, plans and
     * activities, so a block cuts off connecting, chatting and planning.
     */
    function pairIsUnblocked(participants) {
      return !exists(/databases/$(database)/documents/blocks/$(participants[0] + '__' + participants[1]))
        && !exists(/databases/$(database)/documents/blocks/$(participants[1] + '__' + participants[0]));
    }

    // SAFETY — blocks. One document per direction at `blockerId__blockedUserId`.
    // Only the blocker can see or remove it; the blocked person is never told.
    match /blocks/{blockId} {
      // `blockUser()` reads the document BEFORE creating it (idempotency), so
      // `get` must work when it does not exist yet — `resource.data` is null
      // then, which is exactly the bug that broke every first-ever Connect.
      // Authorize from the id instead: its first segment is the blocker.
      allow get: if request.auth != null
        && blockId.split('__')[0] == request.auth.uid;

      // Matched by the client query `where('blockerId', '==', uid)`, so this
      // data-dependent rule is provable from the query (rules are not filters).
      allow list: if request.auth != null
        && request.auth.uid == resource.data.blockerId;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['blockerId', 'blockedUserId', 'reason', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId != request.auth.uid
        && blockId == request.auth.uid + '__' + request.resource.data.blockedUserId
        && (request.resource.data.reason == null || request.resource.data.reason in ['unwanted-contact', 'inappropriate-behavior', 'spam', 'safety-concern', 'other'])
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      // From the id, so unblocking twice is not an error on a missing document.
      allow delete: if request.auth != null
        && blockId.split('__')[0] == request.auth.uid;
    }

    // SAFETY — reports. Write-only for members; nobody can read one back.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['reporterId', 'reportedUserId', 'reason', 'note', 'context', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && boundedString(request.resource.data.reportedUserId, 128)
        && request.resource.data.reportedUserId != request.auth.uid
        // Where the report was filed from. Without a shape check this map
        // accepted anything a client chose to attach.
        && request.resource.data.context is map
        && request.resource.data.context.keys().hasOnly(['type', 'connectionId', 'conversationId'])
        && request.resource.data.context.type in ['profile', 'conversation']
        && boundedOptionalString(request.resource.data.context, 'connectionId', 200)
        && boundedOptionalString(request.resource.data.context, 'conversationId', 200)
        && request.resource.data.reason in ['harassment', 'spam', 'inappropriate-content', 'fake-profile', 'safety-concern', 'other']
        && (request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if false;
    }

    // DISCOVER — public activity posts ("badminton, Sat 5pm, Subang Jaya,
    // RM10–20"). Any signed-in member can browse them. The author creates,
    // edits and removes their own post; other members may only take or give
    // up a spot, or ask for / withdraw from one. It stores ids and choices
    // only — names and photos are resolved from `publicProfiles` at render
    // time. Limits mirror src/constants/activity-posts.ts.
    match /activityPosts/{postId} {
      /** Everything a post may contain. `updatedAt` appears after an edit. */
      function postFields() {
        return ['id', 'authorId', 'sportId', 'startAt', 'timeZone', 'areaId',
                'venueName', 'budget', 'joinPolicy', 'visibility', 'invitedId',
                'capacity', 'joinedIds', 'pendingIds', 'createdAt', 'updatedAt'];
      }

      /** What a NEW post must contain. */
      function createFields() {
        return ['id', 'authorId', 'sportId', 'startAt', 'timeZone', 'areaId',
                'venueName', 'budget', 'joinPolicy', 'visibility', 'invitedId',
                'capacity', 'joinedIds', 'pendingIds', 'createdAt'];
      }

      /** What every post must still contain (posts from before joins existed). */
      function legacyFields() {
        return ['id', 'authorId', 'sportId', 'startAt', 'timeZone', 'areaId',
                'venueName', 'budget', 'createdAt'];
      }

      // A post written before joins existed reads as open, one spot, empty —
      // the same defaults the client mapper uses.
      function joinedOf(data) { return data.get('joinedIds', []); }
      function pendingOf(data) { return data.get('pendingIds', []); }
      function policyOf(data) { return data.get('joinPolicy', 'open'); }
      function capacityOf(data) { return data.get('capacity', 1); }
      function visibilityOf(data) { return data.get('visibility', 'public'); }
      function invitedOf(data) { return data.get('invitedId', null); }

      function pairKey(a, b) { return a < b ? a + '__' + b : b + '__' + a; }

      /** An invite may only ever be created between two CONNECTED buddies. */
      function areConnected(a, b) {
        return exists(/databases/$(database)/documents/connections/$(pairKey(a, b)))
          && get(/databases/$(database)/documents/connections/$(pairKey(a, b))).data.status == 'connected'
          && pairIsUnblocked([a, b]);
      }

      /** Who a new post may be shown to, and the invite that goes with it. */
      function validAudience(data) {
        return (data.visibility == 'invite'
            && data.invitedId is string
            && data.invitedId != request.auth.uid
            && areConnected(request.auth.uid, data.invitedId))
          || (data.visibility in ['public', 'link'] && data.invitedId == null);
      }

      /** The author's choices: the fields posting and editing both validate. */
      function validChoices(data) {
        return boundedString(data.sportId, 64)
          && boundedString(data.areaId, 64)
          && boundedString(data.timeZone, 64)
          && data.venueName is string
          && data.venueName.size() > 0
          && data.venueName.size() <= 80
          // A real upcoming session: not in the past, not absurdly far ahead.
          && data.startAt is timestamp
          && data.startAt > request.time
          && data.startAt < request.time + duration.value(90, 'd')
          && validBudget(data.budget)
          && policyOf(data) in ['open', 'approval'];
      }

      function validBudget(budget) {
        return budget is map
          && budget.keys().hasOnly(['min', 'max'])
          && budget.keys().hasAll(['min', 'max'])
          && budget.min is number
          && budget.min >= 0
          && budget.min <= 10000
          && (budget.max == null
              || (budget.max is number
                  && budget.max >= budget.min
                  && budget.max <= 10000));
      }

      // ---- join-list arithmetic -------------------------------------------
      // The same "exactly this one id changed" pattern as `requestedBy` on
      // connections: nobody can add or remove anyone but the id named here.

      function sameList(before, after) {
        return before.removeAll(after).size() == 0
          && after.removeAll(before).size() == 0
          && after.size() == before.size();
      }

      function addsOnly(before, after, id) {
        return !(id in before)
          && after.removeAll(before) == [id]
          && before.removeAll(after).size() == 0
          && after.size() == before.size() + 1;
      }

      function removesOnly(before, after, id) {
        return id in before
          && before.removeAll(after) == [id]
          && after.removeAll(before).size() == 0
          && after.size() == before.size() - 1;
      }

      /** Exactly one id left the list, and nothing joined it. */
      function removesOne(before, after) {
        return before.removeAll(after).size() == 1
          && after.removeAll(before).size() == 0
          && after.size() == before.size() - 1;
      }

      function onlyJoinListsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['joinedIds', 'pendingIds']);
      }

      /** A member takes the spot on an OPEN post that is not full or started. */
      function isJoiningOpenPost() {
        return request.auth.uid != resource.data.authorId
          && visibilityOf(resource.data) != 'invite'
          && policyOf(resource.data) == 'open'
          && resource.data.startAt > request.time
          && !(request.auth.uid in pendingOf(resource.data))
          && addsOnly(joinedOf(resource.data), joinedOf(request.resource.data), request.auth.uid)
          && sameList(pendingOf(resource.data), pendingOf(request.resource.data))
          && joinedOf(request.resource.data).size() <= capacityOf(resource.data);
      }

      /** A member asks for the spot on an APPROVAL post that still has one. */
      function isRequestingToJoin() {
        return request.auth.uid != resource.data.authorId
          && visibilityOf(resource.data) != 'invite'
          && policyOf(resource.data) == 'approval'
          && resource.data.startAt > request.time
          && joinedOf(resource.data).size() < capacityOf(resource.data)
          && !(request.auth.uid in joinedOf(resource.data))
          && addsOnly(pendingOf(resource.data), pendingOf(request.resource.data), request.auth.uid)
          && sameList(joinedOf(resource.data), joinedOf(request.resource.data))
          && pendingOf(request.resource.data).size() <= 20;
      }

      /** The invited buddy accepts a private invite and takes the spot. */
      function isAcceptingInvite() {
        return visibilityOf(resource.data) == 'invite'
          && request.auth.uid == invitedOf(resource.data)
          && resource.data.startAt > request.time
          && addsOnly(joinedOf(resource.data), joinedOf(request.resource.data), request.auth.uid)
          && sameList(pendingOf(resource.data), pendingOf(request.resource.data))
          && joinedOf(request.resource.data).size() <= capacityOf(resource.data);
      }

      /** A member gives up their own spot, or withdraws their own request. */
      function isLeaving() {
        return request.auth.uid != resource.data.authorId
          && ((removesOnly(joinedOf(resource.data), joinedOf(request.resource.data), request.auth.uid)
                && sameList(pendingOf(resource.data), pendingOf(request.resource.data)))
              || (removesOnly(pendingOf(resource.data), pendingOf(request.resource.data), request.auth.uid)
                && sameList(joinedOf(resource.data), joinedOf(request.resource.data))));
      }

      /** The author moves ONE waiting request into a free spot. */
      function isApproving() {
        return request.auth.uid == resource.data.authorId
          && removesOne(pendingOf(resource.data), pendingOf(request.resource.data))
          && joinedOf(request.resource.data).removeAll(joinedOf(resource.data))
               == pendingOf(resource.data).removeAll(pendingOf(request.resource.data))
          && joinedOf(resource.data).removeAll(joinedOf(request.resource.data)).size() == 0
          && joinedOf(request.resource.data).size() == joinedOf(resource.data).size() + 1
          && joinedOf(request.resource.data).size() <= capacityOf(resource.data);
      }

      /** The author turns down ONE request, or takes ONE person out of the spot. */
      function isDecliningOrRemoving() {
        return request.auth.uid == resource.data.authorId
          && ((removesOne(pendingOf(resource.data), pendingOf(request.resource.data))
                && sameList(joinedOf(resource.data), joinedOf(request.resource.data)))
              || (removesOne(joinedOf(resource.data), joinedOf(request.resource.data))
                && sameList(pendingOf(resource.data), pendingOf(request.resource.data))));
      }

      /** The author edits time, place, sport, budget or join policy. */
      function isAuthorEdit() {
        return resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(postFields())
          && request.resource.data.keys().hasAll(legacyFields())
          && request.resource.data.id == resource.data.id
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          // Who is in, who is waiting and how many fit are not edits.
          && sameList(joinedOf(resource.data), joinedOf(request.resource.data))
          && sameList(pendingOf(resource.data), pendingOf(request.resource.data))
          && capacityOf(request.resource.data) == capacityOf(resource.data)
          // The invited buddy never changes. An invite stays an invite; a
          // shared post may switch between public and link-only.
          && invitedOf(request.resource.data) == invitedOf(resource.data)
          && (visibilityOf(resource.data) == 'invite'
              ? visibilityOf(request.resource.data) == 'invite'
              : visibilityOf(request.resource.data) in ['public', 'link'])
          && validChoices(request.resource.data)
          && request.resource.data.updatedAt == request.time;
      }

      /** Somebody this post is actually about. */
      function isInvolved(data) {
        return data.authorId == request.auth.uid
          || request.auth.uid in joinedOf(data)
          || request.auth.uid in pendingOf(data)
          || invitedOf(data) == request.auth.uid;
      }

      // A single post by id — which is exactly what a share link is. Public
      // and link-only posts open for any signed-in member; a private invite
      // only for the two people it is between.
      allow get: if request.auth != null
        && (visibilityOf(resource.data) != 'invite' || isInvolved(resource.data));

      // Every query must prove itself (rules are not filters): Discover pins
      // `visibility == 'public'`; Activities pins `authorId ==`,
      // `joinedIds array-contains`, `pendingIds array-contains` or
      // `invitedId ==`. A query without one of those is refused, so link-only
      // and invite posts can never be scraped by listing the collection.
      // `resource.data.visibility` is read DIRECTLY here, never through
      // `visibilityOf()`: against a query that does not pin the field, the
      // `get(..., 'public')` default is assumed and the query is allowed —
      // which leaked link-only and invite posts to an unfiltered list.
      allow list: if request.auth != null
        && (resource.data.visibility == 'public' || isInvolved(resource.data));

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(createFields())
        && request.resource.data.keys().hasAll(createFields())
        && request.resource.data.id == postId
        // Nobody can post on somebody else's behalf.
        && request.resource.data.authorId == request.auth.uid
        && validChoices(request.resource.data)
        && validAudience(request.resource.data)
        // A new 1v1 post: one spot, nobody in it or waiting yet.
        && request.resource.data.capacity == 1
        && request.resource.data.joinedIds == []
        && request.resource.data.pendingIds == []
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && (isAuthorEdit()
            || (onlyJoinListsChanged()
                && (isJoiningOpenPost()
                    || isRequestingToJoin()
                    || isAcceptingInvite()
                    || isLeaving()
                    || isApproving()
                    || isDecliningOrRemoving())));

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      // QR CHECK-IN CODE for a 1-to-1 activity — the same shape as a group
      // activity's, at `checkIn/current`, readable and writable only by the
      // post's AUTHOR. `attendanceRecords` reads it via a privileged `get()`
      // to verify a scan, so the person checking in never reads it directly.
      match /checkIn/{checkInId} {
        function isPostAuthor() {
          return request.auth.uid
            == get(/databases/$(database)/documents/activityPosts/$(postId)).data.authorId;
        }

        allow get: if request.auth != null && isPostAuthor();
        allow list: if false;
        allow create, update: if request.auth != null
          && isPostAuthor()
          && request.resource.data.keys().hasOnly(['organizerId', 'code', 'updatedAt'])
          && request.resource.data.keys().hasAll(['organizerId', 'code', 'updatedAt'])
          && request.resource.data.organizerId == request.auth.uid
          && request.resource.data.code is string
          // A host may choose their own code, so its SHAPE is checked here as
          // well as in the form: letters and digits, long enough not to be
          // guessed by someone who merely knows the activity exists.
          && request.resource.data.code.size() >= 4
          && request.resource.data.code.size() <= 24
          && request.resource.data.code.matches('^[A-Z0-9]+$')
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // DISCOVER — PUBLIC GROUP activities ("Saturday Badminton Meetup, 8
    // players, RM10–20"). Deliberately simpler than `activityPosts`: no
    // visibility tiers (always public — the whole point is that strangers
    // can find it), no approval policy (Join adds you straight away if there
    // is a free spot). The organizer creates, edits and removes their own
    // activity; any other member may only add or remove THEIR OWN id in
    // `participantIds`. Limits mirror src/constants/group-activities.ts.
    //
    // Free/Buddy+ host and join limits are NOT enforced here — a `create` or
    // `participantIds` update rule cannot count a member's OTHER live
    // documents without a maintained counter this project does not have.
    // `groupActivityService` enforces both before writing; see
    // `docs/monetization.md` for this documented, honest limitation.
    match /groupActivities/{activityId} {
      function groupActivityFields() {
        return ['id', 'organizerId', 'sportId', 'title', 'description',
                'startAt', 'endAt', 'timeZone', 'areaId', 'venueName',
                'budget', 'preferredSkillLevel', 'maxParticipants',
                'participantIds', 'createdAt', 'updatedAt'];
      }

      function groupActivityCreateFields() {
        return ['id', 'organizerId', 'sportId', 'title', 'description',
                'startAt', 'endAt', 'timeZone', 'areaId', 'venueName',
                'budget', 'preferredSkillLevel', 'maxParticipants',
                'participantIds', 'createdAt'];
      }

      function participantsOf(data) { return data.get('participantIds', []); }

      function validGroupBudget(budget) {
        return budget is map
          && budget.keys().hasOnly(['min', 'max'])
          && budget.keys().hasAll(['min', 'max'])
          && budget.min is number
          && budget.min >= 0
          && budget.min <= 10000
          && (budget.max == null
              || (budget.max is number
                  && budget.max >= budget.min
                  && budget.max <= 10000));
      }

      /** The organizer's choices: the fields creating and editing both validate. */
      function validGroupActivityChoices(data) {
        return boundedString(data.sportId, 64)
          && boundedString(data.areaId, 64)
          && boundedString(data.timeZone, 64)
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 60
          && boundedOptionalString(data, 'description', 500)
          && data.venueName is string
          && data.venueName.size() > 0
          && data.venueName.size() <= 80
          // A real upcoming session: not in the past, not absurdly far ahead.
          && data.startAt is timestamp
          && data.startAt > request.time
          && data.startAt < request.time + duration.value(90, 'd')
          && (data.endAt == null || (data.endAt is timestamp && data.endAt > data.startAt))
          && validGroupBudget(data.budget)
          && data.preferredSkillLevel in ['any', 'beginner', 'casual', 'intermediate', 'advanced']
          && data.maxParticipants is int
          && data.maxParticipants >= 2
          && data.maxParticipants <= 30;
      }

      // ---- participant-list arithmetic (same shape as activityPosts) ------

      function sameList(before, after) {
        return before.removeAll(after).size() == 0
          && after.removeAll(before).size() == 0
          && after.size() == before.size();
      }

      function addsOnly(before, after, id) {
        return !(id in before)
          && after.removeAll(before) == [id]
          && before.removeAll(after).size() == 0
          && after.size() == before.size() + 1;
      }

      function removesOnly(before, after, id) {
        return id in before
          && before.removeAll(after) == [id]
          && after.removeAll(before).size() == 0
          && after.size() == before.size() - 1;
      }

      function onlyParticipantsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantIds']);
      }

      /** A member takes a free spot on an activity that has not started. */
      function isJoiningGroupActivity() {
        return request.auth.uid != resource.data.organizerId
          && resource.data.startAt > request.time
          && addsOnly(participantsOf(resource.data), participantsOf(request.resource.data), request.auth.uid)
          && participantsOf(request.resource.data).size() <= resource.data.maxParticipants;
      }

      /** A member gives up their own spot. Always allowed, even once started. */
      function isLeavingGroupActivity() {
        return request.auth.uid != resource.data.organizerId
          && removesOnly(participantsOf(resource.data), participantsOf(request.resource.data), request.auth.uid);
      }

      /** The organizer removes ONE participant (a no-show, a change of plan). */
      function isOrganizerRemoving() {
        return request.auth.uid == resource.data.organizerId
          && participantsOf(resource.data).removeAll(participantsOf(request.resource.data)).size() == 1
          && participantsOf(request.resource.data).removeAll(participantsOf(resource.data)).size() == 0
          && participantsOf(request.resource.data).size() == participantsOf(resource.data).size() - 1;
      }

      /** The organizer edits everything except identity and who has joined. */
      function isOrganizerEdit() {
        return resource.data.organizerId == request.auth.uid
          && request.resource.data.keys().hasOnly(groupActivityFields())
          && request.resource.data.keys().hasAll(groupActivityCreateFields())
          && request.resource.data.id == resource.data.id
          && request.resource.data.organizerId == resource.data.organizerId
          && request.resource.data.createdAt == resource.data.createdAt
          && sameList(participantsOf(resource.data), participantsOf(request.resource.data))
          && validGroupActivityChoices(request.resource.data)
          && request.resource.data.updatedAt == request.time;
      }

      // Always public — a single activity by id is exactly what a share link
      // is, and there is no private tier here (see `activityPosts` for that).
      allow get: if request.auth != null;

      // Every query must prove itself (rules are not filters), but nothing
      // here is ever hidden, so an equality on any ONE indexed field is
      // enough: Discover pins `startAt >`, Activities pins `organizerId ==`
      // or `participantIds array-contains`.
      allow list: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(groupActivityCreateFields())
        && request.resource.data.keys().hasAll(groupActivityCreateFields())
        && request.resource.data.id == activityId
        // Nobody can host on somebody else's behalf.
        && request.resource.data.organizerId == request.auth.uid
        && validGroupActivityChoices(request.resource.data)
        && request.resource.data.participantIds == []
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && (isOrganizerEdit()
            || (onlyParticipantsChanged()
                && (isJoiningGroupActivity()
                    || isLeavingGroupActivity()
                    || isOrganizerRemoving())));

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.organizerId;

      // QR CHECK-IN CODE — one document, at `checkIn/current`. Readable and
      // writable only by the activity's organizer; `attendanceRecords`
      // below reads it via `get()` (a privileged cross-document read, not
      // subject to this collection's OWN `allow get`) to verify a scan.
      match /checkIn/{checkInId} {
        function isOrganizer() {
          return request.auth.uid
            == get(/databases/$(database)/documents/groupActivities/$(activityId)).data.organizerId;
        }

        allow get: if request.auth != null && isOrganizer();
        allow list: if false;
        allow create, update: if request.auth != null
          && isOrganizer()
          && request.resource.data.keys().hasOnly(['organizerId', 'code', 'updatedAt'])
          && request.resource.data.keys().hasAll(['organizerId', 'code', 'updatedAt'])
          && request.resource.data.organizerId == request.auth.uid
          && request.resource.data.code is string
          // A host may choose their own code, so its SHAPE is checked here as
          // well as in the form: letters and digits, long enough not to be
          // guessed by someone who merely knows the activity exists.
          && request.resource.data.code.size() >= 4
          && request.resource.data.code.size() <= 24
          && request.resource.data.code.matches('^[A-Z0-9]+$')
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // QR CHECK-IN — immutable verified-attendance records. "Past is not
    // completed" (STEP 13) still holds for `groupActivities`: a record here
    // is a SEPARATE, additive fact ("this device scanned this activity's
    // code"), never a status on the activity, and its absence is never read
    // as "did not attend". See `src/types/attendance.ts`.
    match /attendanceRecords/{recordId} {
      /**
       * A check-in names an activity that is EITHER a public group activity or
       * a 1-to-1 activity post, so every check below resolves the source
       * document first. The two collections are named here and nowhere else —
       * never derived from client data.
       */
      function isGroupActivity(id) {
        return exists(/databases/$(database)/documents/groupActivities/$(id));
      }

      function sourceData(id) {
        return isGroupActivity(id)
          ? get(/databases/$(database)/documents/groupActivities/$(id)).data
          : get(/databases/$(database)/documents/activityPosts/$(id)).data;
      }

      /** The organizer of a group activity, or the author of a 1-to-1 post. */
      function hostOf(id) {
        let data = sourceData(id);
        return data.get('organizerId', data.get('authorId', ''));
      }

      function currentCheckInCode(id) {
        return isGroupActivity(id)
          ? get(/databases/$(database)/documents/groupActivities/$(id)/checkIn/current).data.code
          : get(/databases/$(database)/documents/activityPosts/$(id)/checkIn/current).data.code;
      }

      /**
       * When check-in stops being accepted: 30 minutes after the activity
       * ends, or after an assumed 2 hours when the organizer gave no end
       * time. Mirrors `getCheckInWindow()` in `src/lib/attendance.ts` — a
       * check-in is evidence you were there, so it cannot be recorded days
       * later from home.
       */
      function checkInClosesAt(id) {
        let data = sourceData(id);
        // `endAt` is optional AND nullable, so it is only used when it really
        // is a timestamp; otherwise the session is assumed to run 2 hours.
        let endsAt = data.keys().hasAny(['endAt']) && data.endAt is timestamp
          ? data.endAt
          : data.startAt + duration.value(120, 'm');
        return endsAt + duration.value(30, 'm');
      }

      /**
       * Involved: the host checking themselves in, a joined participant of a
       * group activity, or whoever took the spot on a 1-to-1 post.
       */
      function isInvolvedInActivity(id) {
        let data = sourceData(id);
        return request.auth.uid == hostOf(id)
          || request.auth.uid in data.get('participantIds', [])
          || request.auth.uid in data.get('joinedIds', []);
      }

      /**
       * The attendee themselves, or the activity's host (to see who came).
       *
       * The `!exists(...)` branch matters: `checkIn()` READS this document
       * before writing it, to stay idempotent. On a document that does not
       * exist yet there is no `resource.data` to authorize from, so the rule
       * could not be evaluated at all and the read was refused — which
       * surfaced as "We couldn't check you in" before any write was tried.
       * A record's id is `{activityId}__{userId}`, so the caller is
       * authorized from the id, exactly as connections and plans do.
       */
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/attendanceRecords/$(recordId))
            ? recordId.split('__')[recordId.split('__').size() - 1] == request.auth.uid
            : (request.auth.uid == resource.data.userId
               || request.auth.uid == hostOf(resource.data.activityId)));

      // Every query must prove itself: a member's own Reliability Profile
      // pins `userId ==`; the organizer's attendee list pins `activityId ==`.
      allow list: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.uid == hostOf(resource.data.activityId));

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'activityId', 'userId', 'code', 'checkedInAt'])
        && request.resource.data.keys().hasAll(['id', 'activityId', 'userId', 'code', 'checkedInAt'])
        && request.resource.data.id == recordId
        && recordId == request.resource.data.activityId + '__' + request.resource.data.userId
        // Only the attendee may record their OWN check-in — never someone else's.
        && request.resource.data.userId == request.auth.uid
        && isInvolvedInActivity(request.resource.data.activityId)
        // The activity has actually started, and check-in has not closed.
        && sourceData(request.resource.data.activityId).startAt <= request.time
        && request.time <= checkInClosesAt(request.resource.data.activityId)
        // The scanned code matches the organizer's CURRENT code — a stale
        // screenshot stops working the moment the organizer regenerates it.
        && request.resource.data.code == currentCheckInCode(request.resource.data.activityId)
        && request.resource.data.checkedInAt == request.time;

      // Immutable: a check-in is a fact about the past, never edited or removed.
      allow update, delete: if false;
    }

    // PRIVATE. `users/{uid}` holds account fields, the sports profile and the
    // user's preferences (discovery filters, privacy, notifications). It is
    // never readable by anyone else — Discover reads publicProfiles instead.
    match /users/{userId} {
      /**
       * The complete set of keys this document may contain. Without it a
       * client could attach anything it liked to its own profile — a `role`,
       * an `isAdmin`, a copy of somebody else's document — and a later
       * feature that trusted such a field would inherit the hole.
       */
      function userFields() {
        return ['id', 'email', 'displayName', 'photoUrl', 'bio', 'sports',
                'intents', 'preferredIntensity', 'availability', 'area',
                'radiusKm', 'budget', 'preferences', 'onboardingCompleted',
                'createdAt', 'updatedAt', 'gender', 'instagramUsername',
                'linkedinUsername'];
      }

      function wellFormedUser(data) {
        return data.keys().hasOnly(userFields())
          && boundedOptionalString(data, 'displayName', maxDisplayName())
          && boundedOptionalString(data, 'bio', maxBio())
          && validSocialUsername(data, 'instagramUsername')
          && validSocialUsername(data, 'linkedinUsername')
          && validGender(data)
          && (!('sports' in data) || data.sports.size() <= maxSports());
      }

      function genderIsImmutable() {
        return !('gender' in resource.data)
          || resource.data.gender == null
          ? validGender(request.resource.data)
          : ('gender' in request.resource.data
             && request.resource.data.gender == resource.data.gender);
      }

      allow get, list: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && wellFormedUser(request.resource.data)
        && 'gender' in request.resource.data
        && validGender(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && wellFormedUser(request.resource.data)
        && genderIsImmutable();
      allow delete: if false;
    }

    // DISCOVERY-SAFE projection, written only by its owner and readable by any
    // signed-in member. It must only ever contain DiscoveryProfile fields (see
    // src/lib/discovery-profile.ts); a document is deleted when the owner
    // turns discoverability off.
    match /publicProfiles/{userId} {
      /**
       * EXACTLY the DiscoveryProfile allowlist from
       * src/lib/discovery-profile.ts. Every signed-in member can read this
       * document, so the rules state its shape rather than trusting the
       * client's projection: an `email` or a `radiusKm` written here would be
       * a privacy leak, not merely an unexpected field.
       */
      function discoveryFields() {
        return ['userId', 'displayName', 'photoUrl', 'bio', 'sports',
                'intents', 'preferredIntensity', 'availability', 'area',
                'budget', 'profileCompleteness', 'discoverable', 'updatedAt',
                'gender'];
      }

      function wellFormedProjection(data) {
        return data.keys().hasOnly(discoveryFields())
          && boundedString(data.displayName, maxDisplayName())
          && boundedOptionalString(data, 'bio', maxBio())
          && validGender(data)
          && (!('sports' in data) || data.sports.size() <= maxSports());
      }

      function projectionGenderIsImmutable() {
        return !('gender' in resource.data)
          || resource.data.gender == null
          ? validGender(request.resource.data)
          : ('gender' in request.resource.data
             && request.resource.data.gender == resource.data.gender);
      }

      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && wellFormedProjection(request.resource.data)
        && 'gender' in request.resource.data
        && validGender(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && wellFormedProjection(request.resource.data)
        && projectionGenderIsImmutable();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // RELATIONSHIP state — one document per pair, at the deterministic id
    // `sorted(a, b).join('__')` (see src/lib/connection.ts). Readable only by
    // its two participants. The invariants that matter:
    //
    //   * participants can never change, and never number anything but two
    //   * the document id must match the participants, so one pair can never
    //     hold two half-relationships
    //   * a user may only ever add THEMSELVES to `requestedBy`, and can never
    //     remove the other person's request
    //   * `status` can only become `connected` when both participants have
    //     asked, and `connectedAt` only then
    //   * a pending request can be deleted only by its sole requester;
    //     a connected relationship cannot be deleted in this step
    //
    // It stores ids and relationship metadata only: no profile copy, no
    // compatibility score, no matching reasons.
    match /connections/{connectionId} {
      function incoming() { return request.resource.data; }
      function current() { return resource.data; }

      function pairId(a, b) {
        return a < b ? a + '__' + b : b + '__' + a;
      }

      function isParticipant(data) {
        return request.auth != null && request.auth.uid in data.participants;
      }

      function fields() {
        return ['id', 'participants', 'requestedBy',
                'status', 'createdAt', 'updatedAt', 'connectedAt'];
      }

      function wellFormed(data) {
        return data.keys().hasOnly(fields())
          && data.keys().hasAll(fields())
          && data.id == connectionId
          && data.participants is list
          && data.participants.size() == 2
          && data.participants[0] != data.participants[1]
          && connectionId == pairId(data.participants[0], data.participants[1])
          && data.requestedBy is list
          && data.requestedBy.size() >= 1
          && data.requestedBy.size() <= 2
          && data.participants.hasAll(data.requestedBy)
          && (data.status == 'pending' || data.status == 'connected')
          && data.updatedAt == request.time;
      }

      // `connected` is only legitimate once both participants have asked.
      function statusMatchesRequests(data) {
        return data.requestedBy.hasAll(data.participants)
          ? data.status == 'connected' && data.connectedAt == request.time
          : data.status == 'pending' && data.connectedAt == null;
      }

      // `list` is the realtime subscription's own query
      // (`participants array-contains uid` + `limit`) — it can only ever
      // match documents that already exist, so it stays the plain
      // participant check. Combining a `list` rule with `exists()` (as the
      // `get` rule below needs) risks Firestore being unable to evaluate the
      // query per-document at all, silently failing the WHOLE subscription
      // rather than one document — keeping them separate is what avoids that.
      allow list: if isParticipant(current());

      // The `!exists(...)` branch is only for a single-document `get`, which
      // is what lets `connect()`'s transaction check a brand-new pair before
      // creating it — see `uidInPairId()`.
      allow get: if request.auth != null
        && uidInPairId(request.auth.uid, connectionId)
        && (!exists(/databases/$(database)/documents/connections/$(connectionId))
            || isParticipant(current()));

      allow create: if isParticipant(incoming())
        && wellFormed(incoming())
        && pairIsUnblocked(incoming().participants)
        // A new request can only ever be the caller's own, and only pending.
        && incoming().requestedBy == [request.auth.uid]
        && incoming().status == 'pending'
        && incoming().connectedAt == null
        && incoming().createdAt == request.time;

      allow update: if isParticipant(current())
        && wellFormed(incoming())
        && pairIsUnblocked(incoming().participants)
        && incoming().participants == current().participants
        && incoming().id == current().id
        && incoming().createdAt == current().createdAt
        // A connected relationship is immutable until a deliberate
        // disconnect flow exists.
        && current().status == 'pending'
        // Exactly one change is permitted: the caller adding themselves.
        && !(request.auth.uid in current().requestedBy)
        && incoming().requestedBy.removeAll(current().requestedBy)
             == [request.auth.uid]
        && current().requestedBy.removeAll(incoming().requestedBy).size() == 0
        && statusMatchesRequests(incoming());

      // Two ways a relationship document may go:
      //  * cancelling your own outgoing request — never someone else's, and
      //  * "Unconnect": either participant may end a CONNECTED relationship.
      // Deleting it removes the permission that chat and planning check, so
      // both stop at once; connecting again starts from a fresh request.
      allow delete: if isParticipant(current())
        && ((current().status == 'pending'
              && current().requestedBy == [request.auth.uid])
            || current().status == 'connected');
    }

    // CONVERSATIONS live at the connection's own id, so every access check is
    // a single lookup at `connections/{conversationId}`. That lookup is the
    // whole authorization model: `uid in participants` alone would let a user
    // fabricate a conversation with somebody they are not connected to.
    //
    // Messages are IMMUTABLE: create only, never update, never delete.
    match /conversations/{conversationId} {
      function connectionPath() {
        return /databases/$(database)/documents/connections/$(conversationId);
      }

      // Costs one document read per rule evaluation — the price of not
      // trusting the client about who may talk to whom.
      function connection() {
        return get(connectionPath()).data;
      }

      function connectedParticipant() {
        return request.auth != null
          && exists(connectionPath())
          && connection().status == 'connected'
          && pairIsUnblocked(connection().participants)
          && request.auth.uid in connection().participants;
      }

      function conversationFields() {
        return ['id', 'connectionId', 'participants', 'lastMessageText',
                'lastMessageSenderId', 'lastMessageAt', 'createdAt',
                'updatedAt'];
      }

      // `list` is the Messages list's own subscription
      // (`participants array-contains uid` + `limit`) — a real live-project
      // failure showed that combining a `list` query with an external
      // `get()`/`exists()` call (as `connectedParticipant()` makes, into the
      // `connections` collection) comes back permission-denied for the WHOLE
      // query, even when every individual document would legitimately pass.
      // `conversations` already stores its own `participants`, so `list`
      // checks that directly instead — no external read, and a query can
      // only ever match a document that already exists in the first place.
      // A stronger `connectedParticipant()` check still gates every WRITE and
      // every single-document `get()` below, so this is not a real narrowing
      // of who may read what — see `docs/chat.md` for the full incident.
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow get: if connectedParticipant();

      allow create: if connectedParticipant()
        && request.resource.data.keys().hasOnly(conversationFields())
        && request.resource.data.keys().hasAll(conversationFields())
        && request.resource.data.id == conversationId
        && request.resource.data.connectionId == conversationId
        // Exactly the connection's participants — no invented third person.
        && request.resource.data.participants == connection().participants
        && request.resource.data.lastMessageText == null
        && request.resource.data.lastMessageSenderId == null
        && request.resource.data.lastMessageAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Only the message preview may move, and only to the caller's own
      // message. Identity fields are frozen after creation.
      allow update: if connectedParticipant()
        && request.resource.data.keys().hasOnly(conversationFields())
        && request.resource.data.keys().hasAll(conversationFields())
        && request.resource.data.id == resource.data.id
        && request.resource.data.connectionId == resource.data.connectionId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastMessageSenderId == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() > 0
        // Mirrors MAX_MESSAGE_LENGTH in src/constants/chat.ts.
        && request.resource.data.lastMessageText.size() <= 1000
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        function messageFields() {
          return ['id', 'conversationId', 'senderId', 'content', 'createdAt'];
        }

        /**
         * SECURITY RULES ARE NOT FILTERS. The message subscription queries
         * this subcollection with `orderBy('createdAt','desc') + limit()`
         * and NO `where` clause, so Firestore cannot prove that a rule
         * reading `resource.data` holds for every possible result — it
         * rejects the WHOLE query rather than dropping documents. A `list`
         * rule here must therefore be QUERY-INDEPENDENT: path and
         * `request.auth` only, never document data.
         *
         * `conversationId` IS the connection id, which already encodes both
         * participants, so `uidInPairId` authorizes from the path alone —
         * no document read, nothing for a query to contradict. Every WRITE,
         * and every single-document `get`, still goes through the full
         * `connectedParticipant()` check below.
         */
        //
        // The block check uses the same path-derived pair, so it stays
        // query-independent: a blocked pair can no longer read the history.
        allow list: if request.auth != null
          && uidInPairId(request.auth.uid, conversationId)
          && pairIsUnblocked(conversationId.split('__'));

        allow get: if connectedParticipant();

        allow create: if connectedParticipant()
          && request.resource.data.keys().hasOnly(messageFields())
          && request.resource.data.keys().hasAll(messageFields())
          && request.resource.data.id == messageId
          && request.resource.data.conversationId == conversationId
          // Nobody can post as somebody else.
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.content is string
          // `trim()` so a whitespace-only message is rejected server-side too.
          && request.resource.data.content.trim().size() > 0
          // Mirrors MAX_MESSAGE_LENGTH in src/constants/chat.ts.
          && request.resource.data.content.size() <= 1000
          && request.resource.data.createdAt == request.time;

        // Messages are immutable in this step.
        allow update, delete: if false;
      }
    }

    // ACTIVITY PLANS. One active plan per connection, at the deterministic id
    // `<connectionId>__active`, so authorization is a single lookup at
    // `connections/{connectionId}` — the same trick conversations use.
    //
    // The rule that matters most: a participant may only ever move their OWN
    // acceptance. Gary cannot add Aina to `acceptedBy`, and cannot mark a
    // plan `ready` that Aina has not agreed to.
    match /activityPlans/{planId} {
      function incoming() { return request.resource.data; }
      function current() { return resource.data; }

      function connectionPath(connectionId) {
        return /databases/$(database)/documents/connections/$(connectionId);
      }

      function connection(connectionId) {
        return get(connectionPath(connectionId)).data;
      }

      // Costs one document read per rule evaluation — the price of not
      // trusting the client about who may plan with whom.
      function connectedParticipant(connectionId) {
        return request.auth != null
          && planId == connectionId + '__active'
          && exists(connectionPath(connectionId))
          && connection(connectionId).status == 'connected'
          && pairIsUnblocked(connection(connectionId).participants)
          && request.auth.uid in connection(connectionId).participants;
      }

      // `venueProposal` (STEP 11) is optional on READ so a plan written
      // before it keeps working; `requiredPlanFields()` is what must exist.
      function planFields() {
        return ['id', 'connectionId', 'participants', 'status',
                'sportProposal', 'timeProposal', 'budgetProposal',
                'venueProposal', 'createdBy', 'createdAt', 'updatedAt'];
      }

      function requiredPlanFields() {
        return ['id', 'connectionId', 'participants', 'status',
                'sportProposal', 'timeProposal', 'budgetProposal',
                'createdBy', 'createdAt', 'updatedAt'];
      }

      function emptyProposalValue() {
        return {'value': null, 'proposedBy': '', 'acceptedBy': [],
                'version': 0, 'updatedAt': null};
      }

      /** Treats a pre-STEP-11 plan as having an untouched venue proposal. */
      function venueOf(data) {
        return data.get('venueProposal', emptyProposalValue());
      }

      function proposalFields() {
        return ['value', 'proposedBy', 'acceptedBy', 'version', 'updatedAt'];
      }

      function wellFormedProposal(proposal) {
        return proposal.keys().hasOnly(proposalFields())
          && proposal.keys().hasAll(proposalFields())
          && proposal.version is int
          && proposal.version >= 0
          && proposal.acceptedBy is list
          && proposal.acceptedBy.size() <= 2
          && incoming().participants.hasAll(proposal.acceptedBy);
      }

      function emptyProposal(proposal) {
        return proposal.version == 0
          && proposal.value == null
          && proposal.acceptedBy.size() == 0;
      }

      function agreed(proposal) {
        return proposal.version > 0
          && proposal.value != null
          && proposal.acceptedBy.hasAll(incoming().participants);
      }

      // Status is a claim about AGREEMENT, so the rules recompute it rather
      // than trusting whatever the client sent. `venue-agreed` in particular
      // is impossible without BOTH participants accepting the venue.
      function coreAgreed() {
        return agreed(incoming().sportProposal)
          && agreed(incoming().timeProposal)
          && agreed(incoming().budgetProposal);
      }

      function statusMatchesAgreement() {
        return coreAgreed()
          ? (agreed(venueOf(incoming()))
              ? incoming().status == 'venue-agreed'
              : incoming().status == 'ready')
          : incoming().status == 'draft';
      }

      // Either untouched, or a new proposal by the caller (version + 1,
      // acceptance reset to just them), or the caller adding only themselves.
      function proposalChangeIsLegal(before, after) {
        return after == before
          || (after.proposedBy == request.auth.uid
              && after.value != null
              && after.acceptedBy == [request.auth.uid]
              && after.version == before.version + 1)
          || (after.value == before.value
              && after.proposedBy == before.proposedBy
              && after.version == before.version
              && after.acceptedBy.removeAll(before.acceptedBy)
                   == [request.auth.uid]
              && before.acceptedBy.removeAll(after.acceptedBy).size() == 0);
      }

      // The `!exists(...)` branch is what lets `ensureActivePlan()`'s
      // transaction check a brand-new draft before creating it — see
      // `uidInPairId()`. Only valid while a plan id is `{connectionId}__active`
      // (the only shape that exists today) — an archived-plan id scheme would
      // need its own version of this check.
      //
      // `list` is split out even though no query over `activityPlans` exists
      // today (one plan is always opened by its own known id) — combining a
      // `list` rule with `exists()` risks Firestore being unable to evaluate
      // a future query per-document at all, so this keeps that risk out
      // entirely rather than relying on "nothing lists this yet."
      allow list: if connectedParticipant(current().connectionId);

      allow get: if request.auth != null
        && uidInPairId(request.auth.uid, planId)
        && (!exists(/databases/$(database)/documents/activityPlans/$(planId))
            || connectedParticipant(current().connectionId));

      allow create: if connectedParticipant(incoming().connectionId)
        && incoming().keys().hasOnly(planFields())
        && incoming().keys().hasAll(requiredPlanFields())
        && incoming().id == planId
        // Exactly the connection's participants — no invented third person.
        && incoming().participants
             == connection(incoming().connectionId).participants
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'draft'
        && wellFormedProposal(incoming().sportProposal)
        && wellFormedProposal(incoming().timeProposal)
        && wellFormedProposal(incoming().budgetProposal)
        && wellFormedProposal(venueOf(incoming()))
        && emptyProposal(incoming().sportProposal)
        && emptyProposal(incoming().timeProposal)
        && emptyProposal(incoming().budgetProposal)
        && emptyProposal(venueOf(incoming()))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      /**
       * The one status change a client may make by hand: venue-agreed →
       * confirmed, alongside creating the activity. Everything else about
       * the plan must be untouched, and all four proposals must be agreed.
       */
      function isConfirmationWrite() {
        return current().status == 'venue-agreed'
          && incoming().status == 'confirmed'
          && agreed(incoming().sportProposal)
          && agreed(incoming().timeProposal)
          && agreed(incoming().budgetProposal)
          && agreed(venueOf(incoming()))
          && incoming().sportProposal == current().sportProposal
          && incoming().timeProposal == current().timeProposal
          && incoming().budgetProposal == current().budgetProposal
          && venueOf(incoming()) == venueOf(current())
          && incoming().id == current().id
          && incoming().connectionId == current().connectionId
          && incoming().participants == current().participants
          && incoming().createdBy == current().createdBy
          && incoming().createdAt == current().createdAt
          && incoming().keys().hasOnly(planFields())
          && incoming().keys().hasAll(requiredPlanFields())
          && incoming().updatedAt == request.time;
      }

      allow update: if connectedParticipant(current().connectionId)
        && (isConfirmationWrite() || (
        // A confirmed plan is read-only history — no proposal may change.
        current().status != 'confirmed'
        && incoming().keys().hasOnly(planFields())
        && incoming().keys().hasAll(requiredPlanFields())
        // Identity is frozen after creation.
        && incoming().id == current().id
        && incoming().connectionId == current().connectionId
        && incoming().participants == current().participants
        && incoming().createdBy == current().createdBy
        && incoming().createdAt == current().createdAt
        && wellFormedProposal(incoming().sportProposal)
        && wellFormedProposal(incoming().timeProposal)
        && wellFormedProposal(incoming().budgetProposal)
        && wellFormedProposal(venueOf(incoming()))
        && proposalChangeIsLegal(current().sportProposal,
                                 incoming().sportProposal)
        && proposalChangeIsLegal(current().timeProposal,
                                 incoming().timeProposal)
        && proposalChangeIsLegal(current().budgetProposal,
                                 incoming().budgetProposal)
        && proposalChangeIsLegal(venueOf(current()), venueOf(incoming()))
        // A venue only belongs on a plan whose other three are settled.
        && (venueOf(incoming()).version == venueOf(current()).version
            || coreAgreed())
        && statusMatchesAgreement()
        && incoming().updatedAt == request.time
        ));

      allow delete: if false;
    }

    // CONFIRMED ACTIVITIES. The activity lives at its SOURCE PLAN's id, so
    // "one plan produces at most one activity" is a property of the database,
    // and every check here is a single lookup at `activityPlans/{activityId}`.
    //
    // An activity is IMMUTABLE: create only. Reschedule, cancel and
    // completion are later steps, and none of them exist yet.
    match /activities/{activityId} {
      function incoming() { return request.resource.data; }
      function current() { return resource.data; }

      function planPath() {
        return /databases/$(database)/documents/activityPlans/$(activityId);
      }

      function plan() { return get(planPath()).data; }

      function planProposalAgreed(proposal) {
        return proposal.version > 0
          && proposal.value != null
          && proposal.acceptedBy.hasAll(plan().participants);
      }

      function activityFields() {
        return ['id', 'sourcePlanId', 'connectionId', 'participants',
                'sportId', 'startAt', 'endAt', 'budget', 'venue', 'status',
                'createdBy', 'createdAt', 'updatedAt'];
      }

      // `getUpcomingForUser`/`getPastForUser` (STEP 13) query this collection
      // directly (`participants array-contains uid` + a bound on `endAt`),
      // so `list` is real here, not hypothetical. It stays the plain
      // participant check — a query can only ever match documents that
      // already exist. Combining a `list` rule with `exists()` (as `get`
      // below needs) risks Firestore being unable to evaluate the query
      // per-document at all, silently failing the WHOLE history read rather
      // than one document.
      allow list: if request.auth != null
        && request.auth.uid in current().participants;

      // The `!exists(...)` branch is only for a single-document `get`, which
      // is what lets `createFromPlan()`'s transaction check for an
      // already-confirmed activity before writing one — see `uidInPairId()`.
      // Valid while an activity id is its source plan's `{connectionId}__active`
      // id (true today; §STEP 12).
      allow get: if request.auth != null
        && uidInPairId(request.auth.uid, activityId)
        && (!exists(/databases/$(database)/documents/activities/$(activityId))
            || request.auth.uid in current().participants);

      allow create: if request.auth != null
        && exists(planPath())
        && pairIsUnblocked(plan().participants)
        // Only somebody actually in the plan may convert it.
        && request.auth.uid in plan().participants
        && incoming().keys().hasOnly(activityFields())
        && incoming().keys().hasAll(activityFields())
        && incoming().id == activityId
        && incoming().sourcePlanId == activityId
        && incoming().connectionId == plan().connectionId
        && incoming().participants == plan().participants
        // Every part must be mutually agreed on the plan itself.
        && planProposalAgreed(plan().sportProposal)
        && planProposalAgreed(plan().timeProposal)
        && planProposalAgreed(plan().budgetProposal)
        && planProposalAgreed(plan().venueProposal)
        // The snapshot must match what was agreed, not something invented.
        && incoming().sportId == plan().sportProposal.value
        && incoming().venue == plan().venueProposal.value
        && incoming().budget.min == plan().budgetProposal.value.min
        && incoming().budget.max == plan().budgetProposal.value.max
        && incoming().budget.currency == 'MYR'
        && incoming().budget.unit == 'per-person'
        && incoming().startAt is timestamp
        && incoming().endAt is timestamp
        && incoming().endAt > incoming().startAt
        // The document records BUSINESS state only. Upcoming/past is derived
        // from `endAt` at read time, so no client ever writes a temporal
        // state and time passing never requires a write.
        && incoming().status == 'confirmed'
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Immutable in this step.
      allow update, delete: if false;
    }

    // BUDDY RATINGS. A review is a public reliability signal, but only the
    // authenticated participant who wrote it may create it. One deterministic
    // document per activity/reviewer prevents duplicate submissions.
    match /buddyRatings/{ratingId} {
      function incoming() { return request.resource.data; }
      function activity() {
        return get(/databases/$(database)/documents/activities/$(incoming().eventId)).data;
      }
      function validChoiceValues() {
        return incoming().attendanceStatus in ['attended', 'no_show']
          && (incoming().punctuality == null
              || incoming().punctuality in ['on_time', 'late', 'very_late'])
          && (incoming().experience == null
              || incoming().experience in ['great', 'good', 'okay', 'not_great']);
      }

      allow get, list: if request.auth != null;

      allow create: if request.auth != null
        && incoming().keys().hasOnly(['id', 'eventId', 'reviewerId',
                                      'reviewedUserId', 'attendanceStatus',
                                      'punctuality', 'experience', 'note',
                                      'createdAt'])
        && incoming().keys().hasAll(['id', 'eventId', 'reviewerId',
                                     'reviewedUserId', 'attendanceStatus',
                                     'punctuality', 'experience', 'note',
                                     'createdAt'])
        && ratingId == incoming().eventId + '__' + incoming().reviewerId
        && incoming().id == ratingId
        && incoming().reviewerId == request.auth.uid
        && incoming().reviewerId != incoming().reviewedUserId
        && incoming().eventId is string
        && incoming().eventId.size() > 0
        && incoming().eventId.size() <= 200
        && incoming().reviewedUserId is string
        && incoming().reviewedUserId.size() > 0
        && incoming().reviewedUserId.size() <= 128
        && request.auth.uid in activity().participants
        && incoming().reviewedUserId in activity().participants
        && activity().endAt < request.time
        && validChoiceValues()
        && incoming().note is string
        && incoming().note.size() <= 200
        && incoming().createdAt == request.time;

      // MVP policy: a review is immutable after creation.
      allow update, delete: if false;
    }

    // Collections for later steps stay closed until their model exists.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
