# Vitest runs in "test" mode, and Vite loads this file on top of `.env` for
# that mode — so the unit test suite always exercises the mock repositories
# regardless of whatever backend `.env` points the dev server at. Without
# this, switching local dev to VITE_DATA_SOURCE=firebase silently makes
# `npm test` try to hit real Firestore instead of the mocks it's written
# against, since src/repositories/repositories.ts branches on this same var.
VITE_DATA_SOURCE=mock
VITE_VENUE_SOURCE=mock
