# Which backend the repositories talk to: mock | firebase
# `mock` needs no credentials and keeps the app fully usable in development.
VITE_DATA_SOURCE=mock

# Firebase web app config (client config — still keep real values out of git)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Where venue search comes from: mock | google
# Independent of VITE_DATA_SOURCE, so Firebase + mock venues is a valid
# development setup and Google billing is never a prerequisite.
VITE_VENUE_SOURCE=mock

# Google Maps / Places browser key. Public by design, but MUST be restricted
# in Google Cloud: enable only Maps JavaScript API + Places API (New),
# add HTTP referrer restrictions, and set daily quotas. See docs/venues.md.
VITE_GOOGLE_MAPS_API_KEY=
