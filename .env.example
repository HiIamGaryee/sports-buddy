# Which backend the repositories talk to: mock | firebase
# `mock` needs no credentials and keeps the app fully usable in development.
VITE_DATA_SOURCE=mock

# Firebase web app config (client config — still keep real values out of git)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Where venue search comes from: google | openstreetmap | mock
# OpenStreetMap is the default. Google requires a browser API key.
VITE_VENUE_SOURCE=openstreetmap
VITE_GOOGLE_MAPS_API_KEY=

# Public web address share links point at (Firebase Hosting). Optional on the
# web — the current origin is used — but required for links shared from the
# native app, whose own origin is not reachable by anyone else.
VITE_PUBLIC_APP_URL=

# RevenueCat's Android PUBLIC SDK key (Project settings → API keys → Android
# app, or the Test Store key while developing). Purchases only work inside
# the native Android app; leave empty for web/mock — the paywall still shows,
# purchasing just explains it needs the Android app. See docs/monetization.md.
VITE_REVENUECAT_ANDROID_API_KEY=

# Cloudinary, for profile photo uploads (Settings → Product environment →
# Cloud name; Settings → Upload → Upload presets → an UNSIGNED preset). Both
# are public by design. Leave empty and the "Add photo" control is hidden.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=